{
  "name": "dsh-plugin-shadow",
  "version": "0.13.1",
  "private": false,
  "type": "module",
  "description": "Shadow coordinator: supervise work across your projects and dispatch messages to other Sessions, with explicit selection and audit-ready delivery receipts",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "coordinator",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RD2100/rd-shadow.git"
  },
  "homepage": "https://github.com/RD2100/rd-shadow#readme",
  "bugs": {
    "url": "https://github.com/RD2100/rd-shadow/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.3 <0.2.2-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tools": "./lib/tools.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
